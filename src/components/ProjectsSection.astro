---
import SectionHeading from './SectionHeading.astro';
import type { JourneyDetails } from '../data/journey';

interface ProjectItem {
  code: string;
  lang: string;
  name: string;
  desc: string;
  href?: string;
  linkLabel?: string;
  demo?: string;
  details?: JourneyDetails & {
    screenshots?: Array<{ image: string; alt: string; caption: string }>;
  };
  id: string;
}

interface Props {
  projects: {
    sectionLabel: string;
    sectionTitle: string;
    cta: { href: string; id: string; label: string };
    items: ProjectItem[];
  };
}

const { projects } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section id="projects" aria-labelledby="projects-title" data-scene="desk">
  <SectionHeading label={projects.sectionLabel} title={projects.sectionTitle} titleId="projects-title" />

  <div class="projects-grid">
    {
      projects.items.map((project) => {
        const dialogId = `project-detail-${project.id}`;
        const titleId = `${dialogId}-title`;

        return (
          <article class="project-card">
            <div class="project-header">
              <span class="project-code">{project.code}</span>
              <span class="project-lang">{project.lang}</span>
            </div>
            <h3 class="project-name">{project.name}</h3>
            <p class="project-desc">{project.desc}</p>
            {
              (project.href || project.demo) && (
                <div class="project-links">
                  {
                    project.href && (
                      <a href={project.href} class="project-link" target="_blank" rel="noopener" id={project.id}>{project.linkLabel ?? 'Ver repo'}</a>
                    )
                  }
                  {
                    project.demo && (
                      <a href={project.demo} class="project-link" target="_blank" rel="noopener" id={`${project.id}-demo`}>
                        Ver página web
                      </a>
                    )
                  }
                </div>
              )
            }
            {
              project.details && (
                <>
                  <button
                    class="project-more"
                    type="button"
                    aria-haspopup="dialog"
                    aria-controls={dialogId}
                    data-career-dialog-open={dialogId}
                  >
                    Ver más<span aria-hidden="true"> ↗</span>
                  </button>
                  <dialog class="career-dialog project-dialog" id={dialogId} aria-labelledby={titleId} data-career-dialog>
                    <div class="career-dialog__frame">
                      <header class="career-dialog__header">
                        <div>
                          <p class="career-dialog__eyebrow">proyecto</p>
                          <h2 class="career-dialog__title" id={titleId}>{project.name}</h2>
                        </div>
                        <button class="career-dialog__close" type="button" aria-label={`Cerrar detalle de ${project.name}`} data-career-dialog-close>
                          <span aria-hidden="true">×</span>
                        </button>
                      </header>
                      <div class="career-dialog__body">
                        <p class="career-dialog__intro">{project.details.intro}</p>
                        {
                          project.details.sections.length > 0 && (
                            <div class="career-dialog__sections">
                              {
                                project.details.sections.map((section) => (
                                  <section class="career-dialog__section">
                                    <h3>{section.title}</h3>
                                    <p>{section.copy}</p>
                                  </section>
                                ))
                              }
                            </div>
                          )
                        }
                        {
                          project.details.outcomes && project.details.outcomes.length > 0 && (
                            <section class="career-dialog__outcomes">
                              <h3>Resultados</h3>
                              <ul>{project.details.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
                            </section>
                          )
                        }
                        {
                          project.details.link && (
                            <a class="career-dialog__link" href={project.details.link.href} target="_blank" rel="noopener">
                              {project.details.link.label}<span aria-hidden="true"> ↗</span>
                            </a>
                          )
                        }
                        {
                          project.details.screenshots && project.details.screenshots.length > 0 && (
                            <div class="project-dialog__gallery">
                              {
                                project.details.screenshots.map((screenshot) => (
                                  <figure class="project-dialog__shot">
                                    <img
                                      src={`${base}${screenshot.image}`}
                                      alt={screenshot.alt}
                                      width="1200"
                                      height="750"
                                      loading="lazy"
                                      decoding="async"
                                    />
                                    <figcaption>{screenshot.caption}</figcaption>
                                  </figure>
                                ))
                              }
                            </div>
                          )
                        }
                      </div>
                    </div>
                  </dialog>
                </>
              )
            }
          </article>
        );
      })
    }
  </div>

  <div class="projects-footer">
    <a href={projects.cta.href} class="btn btn-outline" target="_blank" rel="noopener" id={projects.cta.id}>
      {projects.cta.label}
    </a>
  </div>
</section>
