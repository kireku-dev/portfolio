---
interface Props {
  label: string;
  title: string;
  titleId: string;
}

const { label, title, titleId } = Astro.props;
const labels: Record<string, string> = {
  'about-title': '01 — Perfil',
  'career-title': '02 — Experiencia',
  'studies-title': '03 — Formación',
  'skills-title': '04 — Capacidades',
  'projects-title': '05 — Trabajo seleccionado',
  'talks-title': '06 — Charlas y talleres',
  'hobbies-title': '07 — Comunidad',
  'contact-title': '08 — Contacto',
};
const [index, name] = (labels[titleId] ?? label).split(' — ');
---

<div class="section-heading">
  <p class="eyebrow section-label"><span class="tick" aria-hidden="true"></span><b>{index}</b>{name && ` / ${name}`}</p>
  <h2 class="section-title" id={titleId}>{title}</h2>
</div>
