---
import { presentationMeta } from '../../data/presentation';
import PresentationHud from './PresentationHud.astro';
import TypographyStage from './TypographyStage.astro';
import ScrollDriver from './ScrollDriver.astro';
---

<div id="presentation-root" class="presentation-root">
  <div id="presentationLoading" class="presentation-loading" role="status" aria-live="polite" aria-hidden="false">
    <div class="presentation-loading__panel presentation-loading__panel--left" aria-hidden="true"></div>
    <div class="presentation-loading__panel presentation-loading__panel--right" aria-hidden="true"></div>
    <div class="presentation-loading__top" data-loader-reveal>
      <span>Portfolio / 2026</span>
      <span>Guatemala · GT</span>
    </div>
    <div class="presentation-loading__center">
      <p class="presentation-loading__eyebrow" data-loader-reveal>Backend · Cloud · Producto</p>
      <p class="presentation-loading__title" data-loader-reveal>Daniel <span>Bautista</span></p>
    </div>
    <div class="presentation-loading__bottom" data-loader-reveal>
      <p class="presentation-loading__copy">{presentationMeta.loadingCopy}</p>
      <span class="presentation-loading__count" id="presentationLoadingCount">000</span>
      <div class="presentation-loading__track" aria-hidden="true">
        <span id="presentationLoadingBar"></span>
      </div>
    </div>
  </div>

  <canvas id="webgl-canvas" class="presentation-canvas" aria-hidden="true"></canvas>
  <div class="presentation-ambient" aria-hidden="true">
    <div class="presentation-ambient__glow" data-parallax-depth="0.7"></div>
    <div class="presentation-ambient__grid"></div>
    <span class="presentation-ambient__index" id="presentationAmbientIndex" data-parallax-depth="-0.35">01</span>
    <span class="presentation-ambient__caption" id="presentationAmbientCaption">Perfil / Ingeniería en movimiento</span>
  </div>
  <div class="presentation-vignette" aria-hidden="true"></div>
  <div class="presentation-grain" aria-hidden="true"></div>

  <PresentationHud variant="presentation" />
  <TypographyStage />
</div>

<ScrollDriver />
