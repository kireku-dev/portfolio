---
const base = import.meta.env.BASE_URL;
const contactMailto =
  'mailto:danibaufu@gmail.com?subject=Contacto%20desde%20el%20portfolio&body=Hola%20Daniel%2C%0A%0A';
---

<div class="typography-stage" id="typographyStage">
  <div class="typography-stage__parallax" data-parallax-depth="0.45">
    <div class="typography-stage__content" aria-live="polite">
      <p class="typography-stage__label" id="beatLabel">01 — Perfil</p>
      <h1 class="typography-stage__primary" id="beatPrimary">Daniel Bautista</h1>
      <h2 class="typography-stage__secondary" id="beatSecondary"></h2>
      <div class="achievement-bubbles" id="achievementBubbles"></div>
      <div class="typography-stage__actions">
        <a class="typography-stage__cta btn btn-primary" id="beatCta" href={`${base}/cv`} hidden>
          Ver CV
        </a>
        <a class="typography-stage__cta btn btn-outline" id="beatContact" href={contactMailto} hidden>
          Contáctame
        </a>
      </div>
    </div>
  </div>
</div>

<div class="presentation-scroll-cue" aria-hidden="true">
  <span class="presentation-scroll-cue__label">Scroll para explorar</span>
  <span class="presentation-scroll-cue__track">
    <span class="presentation-scroll-cue__bar" id="presentationProgressBar"></span>
  </span>
  <span class="presentation-scroll-cue__percent" id="presentationProgressPercent">00%</span>
</div>

<div class="presentation-zones" aria-hidden="true">
  <button type="button" class="presentation-zone presentation-zone--prev" id="presentationZonePrev" tabindex="-1"></button>
  <button type="button" class="presentation-zone presentation-zone--next" id="presentationZoneNext" tabindex="-1"></button>
</div>

<div class="presentation-fallback" id="presentationFallback" hidden>
  <p>Tu dispositivo no pudo iniciar la experiencia 3D.</p>
  <a href={`${base}/cv`} class="btn btn-primary">Ver el CV</a>
</div>
