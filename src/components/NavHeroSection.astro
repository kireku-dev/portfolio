---
interface Props {
  navLinks: { href: string; id: string; label: string }[];
  hero: {
    tag: string;
    name: string;
    alias: string;
    role: string;
    roleDetail: string;
    founder: string;
    summary: string;
    metrics: { value: string; label: string }[];
  };
}

const { navLinks, hero } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navLabels: Record<string, string> = {
  '#about': 'Perfil',
  '#career': 'Experiencia',
  '#projects': 'Proyectos',
  '#talks': 'Charlas',
  '#contact': 'Contacto',
};
const primaryLinks = navLinks.filter((link) => link.href in navLabels);
---

<nav id="navbar" class="site-nav" aria-label="Navegación principal">
  <a href={`${base}/`} class="brand" aria-label="Daniel Bautista — inicio">
    <img src={`${base}/assets/brand/kireku-isotipo.svg`} alt="" width="24" height="24" />
    <span>daniel bautista<b aria-hidden="true">.</b></span>
  </a>

  <ul class="nav-links">
    {primaryLinks.map((link) => <li><a href={link.href} id={link.id}>{navLabels[link.href]}</a></li>)}
  </ul>

  <button type="button" class="nav-action" id="cta-print-cv">Imprimir CV</button>
</nav>

<!-- The hero and the story share one wrapper, so the figure stays pinned beside both. -->
<div class="scrolly" data-story>
<header id="hero" class="hero">
  <div class="hero-copy">
    <p class="eyebrow"><span class="tick" aria-hidden="true"></span>Curriculum vitae <b>/</b> Guatemala · 2026</p>
    <h1 class="hero-name">{hero.name}<span class="hero-name__dot" aria-hidden="true"></span></h1>
    <p class="hero-alias">alias <b>{hero.alias}</b> <span>— {hero.founder}</span></p>
    <p class="hero-title">{hero.role} <em>— {hero.roleDetail}</em></p>
    <p class="hero-summary">{hero.summary}</p>

    <div class="hero-cta">
      <a href="#projects" class="btn btn-primary" id="cta-projects">Ver proyectos <span aria-hidden="true">↘</span></a>
      <a href="#contact" class="btn" id="cta-contact">Hablemos</a>
    </div>
  </div>

  <dl class="hero-metrics" aria-label="Resumen profesional">
    {
      hero.metrics.map((metric) => (
        <div class="metric">
          <dt class="metric-label">{metric.label}</dt>
          <dd class="metric-value">{metric.value}</dd>
        </div>
      ))
    }
  </dl>
</header>

<div class="hero-visual">
  <div class="hero-pin" data-story-pin>
    <slot />
  </div>
</div>

<slot name="story" />
</div>
