---
import AboutSection from '../components/AboutSection.astro';
import CareerSection from '../components/CareerSection.astro';
import ContactSection from '../components/ContactSection.astro';
import DatacenterExperience from '../components/DatacenterExperience.astro';
import FooterSection from '../components/FooterSection.astro';
import HobbiesSection from '../components/HobbiesSection.astro';
import NavHeroSection from '../components/NavHeroSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import StudiesSection from '../components/StudiesSection.astro';
import TalksSection from '../components/TalksSection.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { portfolioData } from '../data/portfolio';
---

<BaseLayout
  title="Daniel Bautista (kireku) — Tech Lead · Backend & Cloud"
  description="Daniel Bautista, alias kireku: tech lead en Vantum ST y fundador de kireku. Backend, infraestructura cloud, GCP y productos confiables. Guatemala."
>
  <main id="cv-document" class="cv-document">
    <NavHeroSection navLinks={portfolioData.navLinks} hero={portfolioData.hero}>
      <DatacenterExperience />
    </NavHeroSection>
    <AboutSection about={portfolioData.about} />
    <CareerSection career={portfolioData.career} />
    <StudiesSection studies={portfolioData.studies} />
    <SkillsSection skills={portfolioData.skills} />
    <ProjectsSection projects={portfolioData.projects} />
    <TalksSection />
    <HobbiesSection hobbies={portfolioData.hobbies} />
    <ContactSection contact={portfolioData.contact} />
  </main>

  <FooterSection footer={portfolioData.footer} />
</BaseLayout>
